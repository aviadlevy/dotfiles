#!/bin/sh
# Merges personal Claude Code preferences into the existing settings.json,
# preserving anything plugins/Claude wrote. Reads stdin, writes stdout.
# Permission mode is per-machine (chezmoi `work` var): auto on the work laptop,
# ask-every-time ("default") on the home laptop.
# Claude attribution on commits and PRs is hidden at home and kept at work.
jq '
  # Appends a Bash hook for $event unless one already runs $cmd.
  def ensure_bash_hook($event; $cmd):
    .hooks[$event] = (
      (.hooks[$event] // []) as $h
      | if any($h[]?.hooks[]?; .command == $cmd) then $h
        else $h + [{"matcher":"Bash","hooks":[{"type":"command","command":$cmd}]}]
        end
    );
  del(.model)
  | .permissions.defaultMode = "auto"
{{- if not .work }}
  | .attribution = {"commit": "", "pr": "", "sessionUrl": false}
{{- end }}
  | .effortLevel = "high"
  | .autoMemoryEnabled = true
  | .autoDreamEnabled = true
  | .skipDangerousModePermissionPrompt = true
  | .autoCompactEnabled = false
  | .remoteControlAtStartup = true
  | .agentPushNotifEnabled = true
  | .skipAutoPermissionPrompt = true
  | .voiceEnabled = true
  # keep the agent-tank status line where its setup.js installed it (it wraps ccstatusline)
  | .statusLine = (if (.statusLine.command // "" | contains("--agent-tank")) then .statusLine else {
      "type": "command",
      "command": "npx -y ccstatusline@latest",
      "padding": 0
    } end)
  | .extraKnownMarketplaces = ({{ .claudeMarketplaces | toJson }} | map_values({source: {source: "github", repo: .}}))
  | .enabledPlugins = ({{ .claudePlugins | toJson }} | map({(.): true}) | add)
  # cmux skills stay installed (manaflow-ai/cmux via `npx skills`) for quick recovery, just hidden.
  # ship-local: the built-in /ship of Claude Code. Off, it still holds the /ship name, so ours is /ship-it.
  | .skillOverrides = ((.skillOverrides // {}) + {
      "cmux": "off",
      "cmux-browser": "off",
      "cmux-diagnostics": "off",
      "cmux-workspace": "off",
      "ship-local": "off"
    })
  | .permissions.allow = ((.permissions.allow // []) + [
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git status*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(git remote*)",
      "Bash(git checkout*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git worktree*)",
      "Bash(git push --force-with-lease origin fix/*)",
      "Bash(git push --force-with-lease origin feat/*)",
      "Bash(git push --force-with-lease origin chore/*)",
      "Bash(git push --force-with-lease origin docs/*)",
      "Bash(git push --force-with-lease origin test/*)",
      "Bash(ls*)",
      "Bash(echo*)",
      "Bash(which*)",
      "Bash(env*)",
      "Bash(file *)",
      "Bash(tail *)",
      "Bash(chezmoi diff*)",
      "Bash(chezmoi data*)",
      "Bash(chezmoi source-path*)",
      "Bash(docker pull*)",
      "Bash(docker restart:*)",
      "Bash(docker logs:*)"
    ] | unique)
  | .deniedMcpServers = ((.deniedMcpServers // []) + ([
      "claude.ai Atlassian",
      "claude.ai Atlassian MCP",
      "claude.ai DataDog",
      "claude.ai GitLab",
      "claude.ai Gmail",
      "claude.ai Google Calendar",
      "claude.ai Salesforce Production (read only)",
      "claude.ai Asana",
      "claude.ai Clay",
      "claude.ai Figma",
      "claude.ai Google Cloud BigQuery",
      "claude.ai HubSpot",
      "claude.ai peecai",
      "claude.ai Semrush",
      "claude.ai Zapier",
      "claude.ai amplemarket",
      "claude.ai oliv.ai",
      "claude.ai Whimsical"
    ] | map({serverName: .})) | unique)
  | .hooks = (.hooks // {})
  | ensure_bash_hook("PostToolUse"; "{{ .chezmoi.homeDir }}/.claude/skills/yoram/yoram-nudge.sh")
  # The skill was renamed ship to ship-it (2026-11-26): drop the hook at its old path.
  | .hooks.PreToolUse = [.hooks.PreToolUse[]? | select(any(.hooks[]?; .command == "{{ .chezmoi.homeDir }}/.claude/skills/ship/require-ship.sh") | not)]
  | ensure_bash_hook("PreToolUse"; "{{ .chezmoi.homeDir }}/.claude/skills/ship-it/require-ship.sh")
'

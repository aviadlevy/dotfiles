#!/bin/bash
# Installs the repo-root Brewfiles: Brewfile everywhere, Brewfile.only_mac on macOS,
# Brewfile.work on a work machine. Runs last (after the files and the other scripts), so a
# failed install blocks nothing; a non-zero exit makes chezmoi retry it. Reruns when any Brewfile changes:
{{- $files := list "Brewfile" }}
{{- if eq .chezmoi.os "darwin" }}{{ $files = append $files "Brewfile.only_mac" }}{{ end }}
{{- if .work }}{{ $files = append $files "Brewfile.work" }}{{ end }}
{{- range $files }}
# {{ . }} {{ include (joinPath $.chezmoi.workingTree .) | sha256sum }}
{{- end }}
set -euo pipefail
if ! command -v brew >/dev/null; then
  echo "brew-bundle: brew not found, skipping (run install.sh first)" >&2
  exit 0
fi

# HOMEBREW_NO_AUTO_UPDATE (zshrc) would leave brew too old to read newer cask definitions
brew update
cat{{ range $files }} {{ joinPath $.chezmoi.workingTree . | quote }}{{ end }} | brew bundle install --file=-

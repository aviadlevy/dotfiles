# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"

# Keep each PATH entry once (first copy wins, which is the one lookup already uses): nested shells
# re-run the `PATH=x:$PATH` lines below.
typeset -U path

{{ if eq .chezmoi.os "linux" -}}
[[ -n $HOMEBREW_PREFIX ]] || eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
{{ else -}}
[[ -n $HOMEBREW_PREFIX ]] || eval "$(/opt/homebrew/bin/brew shellenv)"  # login shells already ran it from ~/.zprofile
{{ end -}}
export PATH="$HOME/.local/bin:$PATH"

plugins=(
{{- range .zshPlugins }}
  {{ . }}
{{- end }}
)
# Generated by .chezmoiscripts/run_onchange_after_shell-completions.sh (uv, poetry, herdr).
fpath=(~/.local/share/zsh/completions $fpath)
FPATH="$HOMEBREW_PREFIX/share/zsh/site-functions:${FPATH}"
source $ZSH/oh-my-zsh.sh  # runs compinit
autoload bashcompinit && bashcompinit

export EDITOR='vim'

export HOMEBREW_NO_AUTO_UPDATE=1

bindkey "^[[H" beginning-of-line
bindkey "^[[F" end-of-line

export ZSH_AUTOSUGGEST_STRATEGY=(history completion)

alias o="open ." # Open the current directory in Finder

[ -f ~/.kubectl_aliases ] && source ~/.kubectl_aliases
function kubectl() { echo "+ kubectl $@">&2; command kubectl $@; }

[ -f ~/.env.jira ] && source ~/.env.jira
[ -f ~/.env.slack ] && source ~/.env.slack
[ -f ~/.env.personal ] && source ~/.env.personal

source ~/.programlangrc
source ~/.customterminalrc

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

{{- if stat (joinPath .chezmoi.homeDir ".bun") }}

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
[ -s "$BUN_INSTALL/_bun" ] && source "$BUN_INSTALL/_bun"
{{- end }}

{{- if stat (joinPath .chezmoi.homeDir ".sdkman") }}
# Kept last so sdkman candidates win on PATH. Their bins and *_HOME are set here, the same way
# sdkman-init.sh sets them; sdkman-init itself (~150ms) loads on the first `sdk` call.
export SDKMAN_DIR="$HOME/.sdkman"
() {
  local c
  for c in $SDKMAN_DIR/candidates/*/current(N); do
    path=($c/bin ${path:#$c/bin})
    export ${(U)c:h:t}_HOME=$c
  done
}
sdk() { unfunction sdk; source "$SDKMAN_DIR/bin/sdkman-init.sh"; sdk "$@" }
{{ end }}

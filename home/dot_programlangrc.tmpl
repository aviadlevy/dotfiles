# enable after installing nvm - https://github.com/nvm-sh/nvm?tab=readme-ov-file#installing-and-updating
{{ if stat (joinPath .chezmoi.homeDir ".nvm") }}
export NVM_DIR="$([ -z "${XDG_CONFIG_HOME-}" ] && printf %s "${HOME}/.nvm" || printf %s "${XDG_CONFIG_HOME}/nvm")"
# Sourcing nvm.sh costs ~2s, so the `default` alias's node goes straight onto PATH and nvm itself
# loads on the first `nvm` call. An alias that is not a plain installed version (lts/*, node, a
# missing version) falls back to sourcing nvm.sh: slow but correct, never a wrong node.
() {
  local want hits=()
  [[ -r $NVM_DIR/alias/default ]] && want=${$(<$NVM_DIR/alias/default)#v}
  [[ $want =~ '^[0-9]+(\.[0-9]+)*$' ]] && hits=($NVM_DIR/versions/node/v${want}(|.*)(N/nOn))
  if (( $#hits )); then
    export NVM_BIN=$hits[1]/bin NVM_INC=$hits[1]/include/node
    path=($NVM_BIN ${path:#$NVM_BIN})
    nvm() { unfunction nvm; \. "$NVM_DIR/nvm.sh" --no-use; nvm "$@" }
  else
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
  fi
}
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion
{{ end }}

# pyenv configurations. enable after installaion - https://github.com/pyenv/pyenv?tab=readme-ov-file#installation
{{ if lookPath "pyenv" }}
export PYENV_ROOT="$HOME/.pyenv"
command -v pyenv >/dev/null || export PATH="$PYENV_ROOT/bin:$PATH"
# Shims go on PATH now, so every child process (make, scripts) gets pyenv's python; the `pyenv`
# shell function (needed for `pyenv shell` / `pyenv rehash`) loads on its first call.
export PYENV_SHELL=zsh
path=($PYENV_ROOT/shims ${path:#$PYENV_ROOT/shims})
pyenv() { unfunction pyenv; eval "$(command pyenv init - --no-rehash zsh)"; pyenv "$@" }
pip() {
  command pip "$@"
  [[ -z "$VIRTUAL_ENV" ]] && pyenv rehash
}
{{ end }}

{{- if lookPath "rbenv" }}
# Same split as pyenv. No rehash per shell: rbenv's gem hook rehashes after `gem install`.
export RBENV_SHELL=zsh
path=(${RBENV_ROOT:-$HOME/.rbenv}/shims ${path:#${RBENV_ROOT:-$HOME/.rbenv}/shims})
rbenv() { unfunction rbenv; eval "$(command rbenv init - --no-rehash zsh)"; rbenv "$@" }
{{ end -}}

{{- if lookPath "jira" }}
{{ end -}}

{{- if and (lookPath "aws") (lookPath "aws_completer") }}
complete -C {{ lookPath "aws_completer" | quote }} aws
{{ end -}}

{{- if and (lookPath "gvgen") (lookPath "brew") }}
{{- $graphviz := output "brew" "--prefix" "graphviz" | trim }}
export PATH={{ $graphviz }}:$PATH
export CFLAGS="-I {{ $graphviz }}/include"
export LDFLAGS="-L {{ $graphviz }}/lib"
{{ end -}}

{{- if lookPath "gcloud" }}
# The next line updates PATH for the Google Cloud SDK.
if [ -f "$HOME/google-cloud-sdk/path.zsh.inc" ]; then . "$HOME/google-cloud-sdk/path.zsh.inc"; fi

# The next line enables shell command completion for gcloud.
if [ -f "$HOME/google-cloud-sdk/completion.zsh.inc" ]; then . "$HOME/google-cloud-sdk/completion.zsh.inc"; fi
{{ end -}}

{{- if lookPath "opam" }}
# opam keeps opam-init/init.zsh current for the global default switch; `opam env` (~300ms) only
# runs when OPAMSWITCH asks for a specific switch.
if [[ -z $OPAMSWITCH && -r ~/.opam/opam-init/init.zsh ]]; then
  source ~/.opam/opam-init/init.zsh >/dev/null 2>&1
else
  export OPAMSWITCH="${OPAMSWITCH:-default}"
  eval "$(opam env --switch "$OPAMSWITCH" --set-switch 2>/dev/null)"
fi
{{ end -}}

{{ if stat (joinPath .chezmoi.homeDir "go" "bin") }}
export PATH=$PATH:$HOME/go/bin
{{ end -}}

{{- if and .work (lookPath "pup") }}
export DD_SITE="datadoghq.eu"
{{ end -}}

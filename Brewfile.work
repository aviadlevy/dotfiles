tap "atlassian/acli"
tap "datadog-labs/pack"
tap "thecasualcoder/stable"
brew "atlassian/acli/acli", trusted: true
brew "awscli"
brew "ffmpeg"
brew "git-filter-repo"
brew "glab"
brew "go"
brew "graphviz"
brew "grpcurl"
brew "helm"
brew "imagemagick"
brew "jira-cli"
brew "kubectx"
brew "libmagic"
brew "opencode"
brew "poppler"
brew "sevenzip"
brew "trivy"
brew "yq"
brew "datadog-labs/pack/pup", trusted: true
brew "thecasualcoder/stable/kube-fzf", trusted: true
# Casks and VS Code extensions are macOS-only in Homebrew.
if OS.mac?
  cask "claude"
  cask "mongodb-compass"
  cask "ngrok"
  cask "ollama-app"
  cask "pgadmin4"
  cask "slack"
  cask "visual-studio-code"
  vscode "eamodio.gitlens"
  vscode "gitlab.gitlab-workflow"
  vscode "golang.go"
  vscode "mhutchie.git-graph"
  vscode "ms-python.python"
  vscode "ms-python.vscode-pylance"
  vscode "redhat.java"
  vscode "redhat.vscode-yaml"
  vscode "sdras.night-owl"
  vscode "tamasfe.even-better-toml"
end
